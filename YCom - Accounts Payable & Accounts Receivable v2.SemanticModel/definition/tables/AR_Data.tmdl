	column AgingBucket = ```
			
			SWITCH( 
			TRUE(), 
			AR_Data[Days Overdue] <= 30, "0–30", 
			AR_Data[Days Overdue] <= 60, "31–60", 
			AR_Data[Days Overdue] <= 90, "61–90", 
			AR_Data[Days Overdue] > 90, ">90" 
			) 
			```
		lineageTag: ba0caee3-e30f-48ca-82bd-3e2931344c14
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Days Overdue' = ```
			
			IF ( 
			    [Amount Received] >= [Invoice Amount], 
			    0,  -- fully paid, not overdue 
			    DATEDIFF([Due Date], TODAY(), DAY) 
			)
			
			```
		formatString: 0
		lineageTag: e8e14f33-8ebe-4b5d-b20f-64222a3996ff
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column AgingBucketSortOrder = ```
			
			SWITCH( 
			    TRUE(),
			    AR_Data[Days Overdue] <= 30, 1, 
			    AR_Data[Days Overdue] <= 60, 2, 
			    AR_Data[Days Overdue] <= 90, 3, 
			    AR_Data[Days Overdue] > 90, 4,
			    BLANK() // Optional: Handle cases where Days Overdue might be null or outside your ranges
			)
			```
		formatString: 0
		lineageTag: 9d891f53-a79f-4855-bd80-6df77534d3ad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

