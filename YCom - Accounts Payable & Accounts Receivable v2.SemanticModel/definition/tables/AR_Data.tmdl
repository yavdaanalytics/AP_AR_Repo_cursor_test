table AR_Data
	lineageTag: fe4922d4-0876-4a0d-a945-35e60c545a02

	measure 'Total Receivables' = ```
			
			SUM(AR_Data[Invoice Amount]) - SUM(AR_Data[Amount Received])
			
			```
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: 37fdb9cb-a1ec-4328-838e-23c01db3c940

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure DSO = AVERAGEX(AR_Data, DATEDIFF(AR_Data[Invoice Date], AR_Data[Received Date], DAY))
		lineageTag: 1182b417-ad28-422c-a8a3-aa7fb6699ff5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Overdue Receivables' = ```
			
			DIVIDE( 
			    SUMX(
			        FILTER(AR_Data, AR_Data[Due Date] < TODAY()), 
			        AR_Data[Invoice Amount] - AR_Data[Amount Received]
			    ), 
			    [Total Receivables]
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d4025216-efbf-4dec-8368-dad98eb50a8d

	measure Inv_Amount = SUM(AR_Data[Invoice Amount])
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: b89e89c5-a95f-4be1-9f3f-70a90c4e3d06

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Collection Efficiency (%)' = ```
			
			DIVIDE(SUM(AR_Data[Amount Received]), SUM(AR_Data[Invoice Amount])) 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dfe3472f-8fe1-4e53-b570-4915e100fafe

	measure TopCustomers = ```
			
			VAR RANKVISIBLE = 
			    RANKX(
			        ALL(AR_Data[Customer Name]),
			        [Total Receivables],
			        ,
			        DESC
			    )
			RETURN
			IF(
			    RANKVISIBLE <= SELECTEDVALUE('Top N Selection'[Value]),
			    [Total Receivables]
			)
			```
		formatString: "₹"\ #,0.00;#,0.00\ -"₹";"₹"\ #,0.00
		lineageTag: d8e098b3-a67c-4676-a049-b0128863a215

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

