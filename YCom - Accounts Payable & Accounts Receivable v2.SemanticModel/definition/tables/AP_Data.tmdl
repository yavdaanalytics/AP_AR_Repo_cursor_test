	column 'Days Overdue' = ```
			
			IF ( 
			[Amount Paid] >= [Bill Amount], 
			
			DATEDIFF([Due Date], TODAY(), DAY) 
			) 
			```
		formatString: 0
		lineageTag: a5119e6e-f96a-44d4-8c7b-052c55dc73e1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column AgingBucket = ```
			
			SWITCH( 
			TRUE(), 
			AP_Data[Days Overdue] <= 30, "0–30", 
			AP_Data[Days Overdue] <= 60, "31–60", 
			AP_Data[Days Overdue] <= 90, "61–90", 
			AP_Data[Days Overdue] > 90, ">90" 
			) 
			```
		lineageTag: c9a1e054-fd1d-4c9d-8125-e00fefa94216
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

