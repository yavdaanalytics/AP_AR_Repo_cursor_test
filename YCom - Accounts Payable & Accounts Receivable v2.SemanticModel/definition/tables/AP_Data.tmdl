table AP_Data
	lineageTag: fdf14bf2-0849-41ec-86db-225f664a31a3

	measure 'Total Payables' = ```
			
			SUM(AP_Data[Bill Amount]) - SUM(AP_Data[Amount Paid])
			
			```
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: 8530b7b9-27f7-4bb4-921f-8f1a53457a8b

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Net Working Capital' = ```
			
			[Total Receivables] - [Total Payables]
			
			```
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: 20251278-576e-4c13-a7a5-72faa6cfb877

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure '% Overdue Payables' = ```
			
			DIVIDE( 
			SUMX(FILTER(AP_Data, AP_Data[Due Date] < TODAY()), AP_Data[Bill Amount] - AP_Data[Amount Paid]), 
			[Total Payables] 
			) 
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9e904ddb-e18e-47af-b1ba-dce26c9865ec

	measure DPO = ```
			AVERAGEX(AP_Data, DATEDIFF(AP_Data[Bill Date], AP_Data[Payment Date], DAY)) 
			```
		lineageTag: 07787f67-adc0-466a-8c08-db997d40967c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure BillAmount = SUM(AP_Data[Bill Amount])
		formatString: 0
		lineageTag: a57a8e9b-9136-43af-8b92-7e77f2bb74a4

	measure 'Unpaid Amount' = ```
			
			SUM(AP_Data[Bill Amount]) - SUM(AP_Data[Amount Paid])
			
			```
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: 068fb086-7d14-4a01-8024-7f74cbecba09

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure TopVendors_AP = ```
			
			VAR RANKVISIBLE = 
			    RANKX(
			        ALL(AP_Data[Vendor Name]),
			        [Unpaid Amount],
			        ,
			        DESC
			    )
			RETURN
			IF(
			    RANKVISIBLE <= SELECTEDVALUE('Top N Selection_AP'[Value]),
			    [Unpaid Amount]
			)
			```
		formatString: "₹"\ #,0;#,0\ -"₹";"₹"\ #,0
		lineageTag: abd6ba3c-342e-4556-ba4b-89c27d8e61d3

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

